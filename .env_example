# =============================================================================
# LinguaTrack - Переменные окружения
# =============================================================================

# Yandex SpeechKit (TTS)
# Получите API ключ и Folder ID в Yandex Cloud Console
YANDEX_SPEECHKIT_API_KEY=your_yandex_api_key_here
YANDEX_SPEECHKIT_FOLDER_ID=your_folder_id_here

# TTL для аудиокеша в секундах (604800 = 7 дней)
AUDIO_CACHE_TTL=604800

# Telegram Bot
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =============================================================================
# Django Settings
# =============================================================================

# В development используется insecure fallback; при DEBUG=False ключ обязателен
# SECRET_KEY=your_django_secret_key_here

# По умолчанию True; понимает true/false, 1/0, yes/no и on/off
# DEBUG=True

# Comma-separated; по умолчанию localhost,127.0.0.1,[::1]
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origins со схемой; по умолчанию список пуст
# CSRF_TRUSTED_ORIGINS=https://example.com

# Django/Celery timezone; по умолчанию UTC
# TIME_ZONE=UTC

# =============================================================================
# База данных (опционально)
# =============================================================================

# SQLite используется, если DATABASE_URL не задан
# Для PostgreSQL поддерживаются postgres:// и postgresql://
# DATABASE_URL=postgresql://user:password@localhost:5432/linguatrack

# =============================================================================
# Celery + Redis (для напоминаний)
# =============================================================================

# Для локального Redis без пароля; special characters в credentials URL-encode
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Локальные service URLs (в Compose используются hostnames web и bot)
# DJANGO_API_URL=http://127.0.0.1:8000
# TELEGRAM_BOT_NOTIFY_URL=http://127.0.0.1:8080/notify

# =============================================================================
# Логирование (опционально)
# =============================================================================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# =============================================================================
# Инструкции по настройке:
# =============================================================================
# 1. Скопируйте этот файл в .env
# 2. Переменные process environment имеют приоритет над .env
# 3. Yandex SpeechKit: https://console.cloud.yandex.ru/
# 4. Telegram Bot: @BotFather в Telegram
# 5. Redis: установите Redis для Celery напоминаний
